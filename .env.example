# ============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# .env 文件已在 .gitignore 中排除，不会被提交到 Git
# ============================================================

# 阿里云百炼 API Key
# 获取地址：https://bailian.console.aliyun.com/
BAILIAN_API_KEY=sk-your-api-key-here

# 百炼 OpenAI 兼容 API 地址
# 文档：https://help.aliyun.com/zh/model-studio/developer-reference/compatibility-of-openai-with-dashscope
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型名称（Qwen 系列）
BAILIAN_MODEL=qwen-plus

# 回收站目录（用于 clean_recycle_bin 工具演示）
# 工具只能操作此目录下的文件，防止路径穿越攻击
RECYCLE_BIN_DIR=./tmp-recycle

# 服务端绘图开关（默认 false = 关闭）
# 关闭时：run_python 里 import matplotlib/seaborn 会直接报错并引导改用 plot_chart，
#         图表统一由 plot_chart 在浏览器端渲染（可交互、可导出 PNG）。
# 需要「服务端生成图片文件」（批量出图、报表归档等）时才改成 true。
ENABLE_SERVER_PLOTTING=false

# 工具调用轮数上限（默认 30）
# 一轮 = 一次模型请求 + 一次工具执行。复杂数据分析往往要「读文件 → 看结构 →
# 聚合 → 画图」多轮接力，上限太小会在分析中途被截断。
# 死循环由下面的 MAX_SAME_CALL_REPEAT 熔断，不靠这个数字硬扛。
MAX_TOOL_ITERATIONS=30

# 重复调用熔断阈值（默认 3）
# 模型连续发起这么多次「完全相同」的工具调用（同名 + 同参数）就判定为空转并停止。
MAX_SAME_CALL_REPEAT=3

# ========== 访问口令（部署到公网时必设！） ==========
# 留空 = 不启用鉴权（本地开发方便，谁都能访问）。
# 设置后，所有 /api/* 业务接口都要求携带有效 token：
#   前端会弹一个口令输入框，输对一次后存 localStorage，之后免输。
# 静态资源（页面 / css / js）不拦截，所以口令界面本身能正常加载。
#
# ⚠️ 不设的风险：任何人打开你的网址就能用你的模型额度跑分析、传文件，
#    可以把你的免费额度刷光。
ACCESS_PASSWORD=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
