# ============================================================
# .gitignore — 防止敏感文件和临时文件入仓
# ============================================================

# 环境变量（包含 API Key，绝对不能提交）
.env

# Python 运行时文件
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
venv/
.venv/
env/
.env.local

# SQLite 数据库文件（包含用户聊天记录）
*.db
*.sqlite
*.sqlite3

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 回收站测试目录（本地测试用）
/tmp-recycle/

# 日志文件
*.log
logs/

# 本地模型文件（太大，不入仓）
*.gguf
*.bin
*.pt
*.pth
*.safetensors
local-model/models/

# 部署临时文件
deploy/*.pem
deploy/*.key

# ============================================================
# 追加（准备开源时补的）—— 本地数据与私有信息
# ============================================================

# data/ 里有用户上传的文件和聊天数据库，属于隐私数据，绝不入仓
/data/

# 本地导出的 PPT / 汇报材料（内含研究数据截图）
/ppt/

# 旧图片备份
/backup/

# 编辑器本地设置
/.claude/
.claude/settings.local.json

# 本机专用的临时渲染脚本（含本地绝对路径）
/render3.js

# 部署脚本的历史备份
/deploy/*.bak-*
/deploy/*.bak
